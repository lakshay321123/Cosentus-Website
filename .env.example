# ================================================
# Supabase — shared with CRM project
# ================================================
# Project URL (public, used client-side)
NEXT_PUBLIC_SUPABASE_URL=
# Anon key (public, used client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-only — used by API routes for writes)
SUPABASE_SERVICE_KEY=

# ================================================
# Sanity CMS
# ================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token for authenticated writes (server-only)
SANITY_API_TOKEN=

# ================================================
# AI services
# ================================================
# Anthropic — powers COSE chatbot (/api/chat)
ANTHROPIC_API_KEY=
# ElevenLabs — powers Cindy voice agent (/api/tts)
ELEVENLABS_API_KEY=

# ================================================
# HubSpot — mirrors website leads into HubSpot Contacts
# ================================================
# Private-app token, scope: crm.objects.contacts.write
# When unset, the /api/crm/leads route writes only to Supabase (no-op for HubSpot).
HUBSPOT_TOKEN=

# ================================================
# Google Tag Manager — site-wide analytics/tag container
# ================================================
# Container ID (public). When set, the GoogleTagManager component loads in app/layout.tsx.
# Leave unset in dev/preview to avoid polluting analytics; set in Vercel Production only.
# GA4 (measurement id G-YVRSSJTVTL) is configured as a tag INSIDE this GTM
# container via the GTM console — there is intentionally no separate gtag.js in code.
NEXT_PUBLIC_GTM_ID=

# ================================================
# Google Search Console — site ownership verification
# ================================================
# Verification token (public; rendered as a <meta name="google-site-verification"> tag).
# When set, app/layout.tsx adds the verification meta tag in <head>.
# Leave unset in dev/preview; set in Vercel Production only.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
